{
	"name": "df_dim_fecha",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				},
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcBilling"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "selPago"
				},
				{
					"name": "union1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'silver',",
				"     tableName: 'admissions',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> source1",
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'silver',",
				"     tableName: 'billing',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcBilling",
				"source1 select(mapColumn(",
				"          fecha = admission_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source1 select(mapColumn(",
				"          fecha = discharge_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"srcBilling select(mapColumn(",
				"          fecha = payment_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selPago",
				"select2, select1, selPago union(byName: true)~> union1",
				"union1 filter(!isNull(fecha)) ~> filter1",
				"filter1 aggregate(groupBy(fecha),",
				"     n = count()) ~> aggregate1",
				"aggregate1 derive(fecha_key = year(fecha)*10000+month(fecha)*100+dayOfMonth(fecha),",
				"          {fecha_completa     } = fecha,",
				"          anio = toShort(year(fecha)),",
				"          trimestre = toByte(floor((month(fecha)-1)/3)+1),",
				"          mes = toByte(month(fecha)),",
				"          mes_nombre = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'][month(fecha)],",
				"          mes_corto = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][month(fecha)],",
				"          semana_anio = toByte(weekOfYear(fecha)),",
				"          dia_mes = toByte(dayOfMonth(fecha)),",
				"          dia_semana = toByte(iif(dayOfWeek(fecha)==1,7,dayOfWeek(fecha)-1))) ~> derivedColumn1",
				"derivedColumn1 derive(trimestre_nombre = 'T'+toString(trimestre),",
				"          dia_nombre = ['Lunes','Martes','Miercoles','Jueves','Viernes','Sabado','Domingo'][dia_semana],",
				"          {es_fin_de_semana     } = dia_semana>=6) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          fecha_key,",
				"          {fecha_completa     },",
				"          anio,",
				"          trimestre,",
				"          mes,",
				"          mes_nombre,",
				"          mes_corto,",
				"          semana_anio,",
				"          dia_mes,",
				"          dia_semana,",
				"          trimestre_nombre,",
				"          dia_nombre,",
				"          {es_fin_de_semana     }",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'gold',",
				"     tableName: 'dim_fecha',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          fecha_key,",
				"          {fecha_completa     },",
				"          anio,",
				"          trimestre,",
				"          mes,",
				"          mes_nombre,",
				"          mes_corto,",
				"          semana_anio,",
				"          dia_mes,",
				"          dia_semana,",
				"          trimestre_nombre,",
				"          dia_nombre,",
				"          {es_fin_de_semana     }",
				"     )) ~> sink1"
			]
		}
	}
}