{
	"name": "df_silver_diagnoses",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcDiagnoses"
				},
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcSilverAdmissions"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sql_dw",
						"type": "LinkedServiceReference"
					},
					"name": "silverdiagnoses"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'bronze',",
				"     tableName: 'diagnoses',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcDiagnoses",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'silver',",
				"     tableName: 'admissions',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcSilverAdmissions",
				"srcDiagnoses derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          c = upper(regexReplace(split(icd_code,',')[1],'[^A-Za-z0-9]','')),",
				"          diagnosis_description = trim(diagnosis_description),",
				"          severity = case(lower(trim(severity))=='mild','Mild',lower(trim(severity))=='moderate','Moderate',lower(trim(severity))=='severe','Severe',lower(trim(severity))=='critical','Critical','Unknown')) ~> derivedColumn1",
				"derivedColumn1 derive(icd_code = substring(c,1,3)+iif(length(c)>3,'.'+substring(c,4,10),'')) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(diagnosis_id) && regexMatch(icd_code,'^[A-Z]\\\\d{2}.*')) ~> filter1",
				"filter1, srcSilverAdmissions exists(derivedColumn1@admission_id == srcSilverAdmissions@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 window(over(diagnosis_id),",
				"     asc(diagnosis_id, true),",
				"     rn = rowNumber()) ~> window1",
				"window1 filter(rn==1) ~> filter2",
				"filter2 select(mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'silver',",
				"     tableName: 'diagnoses',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> silverdiagnoses"
			]
		}
	}
}